# ---------------------------------------------------------------------------
# Copiá este archivo como .env y completá SOLO el proveedor que vayas a usar.
#
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# El archivo .env está en .gitignore: nunca se sube a GitHub.
# ---------------------------------------------------------------------------


# ===========================================================================
#  1. QUÉ MODELO USA EL AGENTE
# ===========================================================================

# claude | openai | gemini | deepseek
PROVEEDOR=deepseek

# --- Claude (Anthropic) ---  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-haiku-4-5

# --- OpenAI ---  https://platform.openai.com/api-keys
OPENAI_API_KEY=
MODELO_OPENAI=gpt-5

# --- Gemini (Google) ---  https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODELO_GEMINI=gemini-2.5-pro

# --- DeepSeek ---  https://api.deepseek.com
DEEPSEEK_API_KEY=
MODELO_DEEPSEEK=deepseek-flash


# ===========================================================================
#  2. DÓNDE SE GUARDAN LAS CONVERSACIONES
# ===========================================================================

# test        → SQLite: un archivo en tu computadora. No instalás nada.
# produccion  → Postgres: para cuando hay varios procesos atendiendo.
MODO=test

# --- MODO=test ---
SQLITE_RUTA=datos/conversaciones.db

# --- MODO=produccion ---
# Formato: postgresql://usuario:clave@servidor:puerto/base
POSTGRES_DSN=


# ===========================================================================
#  3. COMPORTAMIENTO Y COSTO
# ===========================================================================

CACHE=true
MAX_TOKENS=4096
MEMORIA_MENSAJES=20
PROMPT_SISTEMA=prompts/sistema.md


# ===========================================================================
#  4. TELEGRAM
# ===========================================================================

TELEGRAM_TOKEN=


# ===========================================================================
#  5. WHATSAPP  (con Chatwoot en el medio)
# ===========================================================================

CHATWOOT_URL=
CHATWOOT_TOKEN=
CHATWOOT_CUENTA_ID=1
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_ETIQUETA_HUMANO=humano
BUFFER_SEGUNDOS=8
PUERTO=8000

MENSAJES_POR_RESPUESTA=3
TOPE_MENSAJES_POR_DIA=50
LARGO_MAXIMO_DE_ENTRADA=2000
RESPETAR_RESUELTAS=1
SOLO_EL_PRIMER_MENSAJE=0


# ===========================================================================
#  LO QUE LLEGA QUE NO ES TEXTO
# ===========================================================================

DESCRIBIR_IMAGENES=1
MODELO_IMAGENES=

# Transcripción de audios (OpenAI o Groq Cloud)
TRANSCRIBIR_AUDIOS=1
MODELO_TRANSCRIPCION=whisper-large-v3
URL_TRANSCRIPCION=https://api.groq.com/openai/v1/audio/transcriptions


# ===========================================================================
#  QUE PAREZCA UNA PERSONA
# ===========================================================================

PAUSA_ENTRE_GLOBOS=1
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ESPERA_SEGUNDOS=0
SILENCIO_SEGUNDOS=25


# ===========================================================================
#  6. AVISOS POR MAIL
# ===========================================================================

AVISOS_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

SMTP_SERVIDOR=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
